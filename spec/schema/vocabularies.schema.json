{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/littlemex/perigraph/blob/main/spec/schema/vocabularies.schema.json",
  "title": "The shape of spec/vocabularies.json (generated from it)",
  "description": "Every closed vocabulary is an object whose `values` are unique strings. This schema is generated from the file it describes, so it catches a copy that lost a vocabulary or broke one's shape, not a value added in the wrong place -- that is what the conformance cases are for.",
  "type": "object",
  "required": [
    "spec_version",
    "namespace",
    "digest",
    "attributes",
    "receiver_obligations",
    "lineage",
    "parts",
    "model_parts",
    "answer_modes",
    "sourcing",
    "boundaries",
    "never_identifying",
    "refines_only",
    "must_be_known_for_identity",
    "absence_reasons",
    "status",
    "context_crossings",
    "tool_determinism",
    "billed_legs"
  ],
  "properties": {
    "spec_version": {
      "type": "integer"
    },
    "namespace": {
      "const": "perigraph"
    },
    "parts": {
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "model_parts": {
